<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="flowershop.controller.BouquetDialogController"
          hgap="12" vgap="12" styleClass="form-grid" prefWidth="480">
    <columnConstraints>
        <ColumnConstraints halignment="RIGHT" minWidth="90" prefWidth="100"/>
        <ColumnConstraints hgrow="ALWAYS" minWidth="260" prefWidth="340"/>
    </columnConstraints>

    <Label text="Название *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <TextField fx:id="nameField" promptText="Розы «Классика»"
               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Цена, ₽ *" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextField fx:id="priceField" promptText="например 3500 или 3500.50"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Описание" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.valignment="TOP"/>
    <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
              GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="* — обязательные поля" styleClass="hint-label"
           GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3"/>
</GridPane>