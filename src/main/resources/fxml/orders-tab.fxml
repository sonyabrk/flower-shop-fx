<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="flowershop.controller.OrdersController" styleClass="tab-content">
    <top>
        <VBox spacing="10" styleClass="toolbar">
            <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Поиск: клиент, букет или сумма" prefWidth="280"/>
                <ComboBox fx:id="statusFilter" promptText="Все статусы" prefWidth="160"/>
                <DatePicker fx:id="dateFromPicker" promptText="Заказ с" prefWidth="140"/>
                <DatePicker fx:id="dateToPicker" promptText="Заказ по" prefWidth="140"/>
                <ComboBox fx:id="sortBox" promptText="Сортировка" prefWidth="230"/>
                <Button text="Сбросить" onAction="#onReset"/>
            </FlowPane>
            <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
                <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
                <Button fx:id="statusButton" text="Сменить статус" onAction="#onChangeStatus"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
                <Button text="Обновить" onAction="#onRefresh"/>
                <Button text="Экспорт в CSV" onAction="#onExport"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="ordersTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Заказов нет. Измените фильтры или добавьте заказ."/>
            </placeholder>
            <columns>
                <TableColumn fx:id="customerColumn" text="Клиент" prefWidth="200"/>
                <TableColumn fx:id="bouquetColumn" text="Букет" prefWidth="200"/>
                <TableColumn fx:id="quantityColumn" text="Кол-во" prefWidth="70"/>
                <TableColumn fx:id="totalColumn" text="Сумма" prefWidth="120"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="120"/>
                <TableColumn fx:id="orderDateColumn" text="Дата заказа" prefWidth="110"/>
                <TableColumn fx:id="deliveryDateColumn" text="Дата доставки" prefWidth="110"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <Label fx:id="countLabel" styleClass="count-label"/>
    </bottom>
</BorderPane>